{
  "name": "tervory-panel",
  "publisher": "tervory",
  "displayName": "Opli Code",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "tervory",
          "title": "Opli Code",
          "icon": "media/tervory-logo.png"
        }
      ]
    },
    "views": {
      "tervory": [
        {
          "id": "tervory.panel",
          "name": "Opli Code",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tervory.focus",
        "title": "Opli Code: Open panel"
      },
      {
        "command": "tervory.signIn",
        "title": "Opli Code: Trigger sign-in"
      },
      {
        "command": "tervory.search",
        "title": "Opli Code: Codebase search"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
